# Репозиторий публичный: сюда не попадают секреты, данные о фильмах
# (лицензии IMDb, MovieLens, TMDB) и личные данные пользователей бота.

# Секреты
.env
.env.*
!.env.example
*.pem
*.key

# Окружение
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Данные о фильмах и пользователях (скачиваются или собираются локально)
data/
*.tsv
*.tsv.gz
*.csv
*.parquet
*.json.gz

# Базы данных и их резервные копии
*.db
*.db-journal
*.sqlite
*.sqlite3
backups/
*.bak

# Кэш TMDB/OMDb, постеры
cache/
posters/

# Экспорты Letterboxd и другие загруженные архивы
*.zip
uploads/

# Модели и эмбеддинги (обучены на данных с ограничениями)
models/
*.npy
*.npz
*.pkl
*.joblib

# Логи (содержат Telegram ID и сообщения пользователей)
logs/
*.log

# Системное
.DS_Store

# Записка для Claude Code (адрес сервера и детали окружения — не для публичного репозитория)
CLAUDE.md
